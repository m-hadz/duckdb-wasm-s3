-	return paths;
+	return fn(*local_fs);
+}
+
+bool IsUrl(const std::string &path) {
+	return path.find("://") != std::string::npos;
+}
+
+std::string ReadMappingFile(FileSystem &fs, const std::string &path) {
+	auto handle = fs.OpenFile(path, FileFlags::FILE_FLAGS_READ);
+	std::string content;
+	char buffer[16384];
+	while (true) {
+		auto n = handle->Read(buffer, sizeof(buffer));
+		if (n <= 0) {
+			break;
+		}
+		content.append(buffer, static_cast<size_t>(n));
+	}
+	return content;
+}
+
+std::string MappingBaseUri(FileSystem &fs, const std::string &path) {
+	if (IsUrl(path)) {
+		return path;
+	}
+	auto absolute = fs.IsPathAbsolute(path) ? path : fs.JoinPath(FileSystem::GetWorkingDirectory(), path);
+	return (absolute.rfind('/', 0) == 0 ? "file://" : "file:///") + absolute;
+}
+
+} // namespace
+
+std::vector<std::string> ResolveMappingFiles(const std::string &path_or_glob, ClientContext *context) {
+	return WithMappingFileSystem(context, [&](FileSystem &fs) {
+		std::vector<std::string> paths;
+		// Remote filesystems may not list (plain HTTP cannot); a literal URL is
+		// taken as-is and a missing file surfaces when it is read.
+		if (IsUrl(path_or_glob) && !FileSystem::HasGlob(path_or_glob)) {
+			paths.push_back(path_or_glob);
+			return paths;
+		}
+		auto matches = fs.Glob(path_or_glob);
+		paths.reserve(matches.size());
+		for (auto &match : matches) {
+			paths.push_back(match.path);
+		}
+		std::sort(paths.begin(), paths.end());
+		return paths;
+	});
 }
 
