diff --git a/src/serd_buffer.cpp b/src/serd_buffer.cpp
index 5f47d4d..e982277 100644
--- a/src/serd_buffer.cpp
+++ b/src/serd_buffer.cpp
@@ -8,6 +8,21 @@
 
 static const size_t READ_BUFFER_SIZE = 1024 * 1024;
 
+// serd treats a short read as end of stream (fread semantics), but a FileHandle
+// may legitimately return less than asked for - duckdb-wasm's HTTP reads come
+// back in 16 KiB pieces - so keep reading until the request is filled or EOF.
+static int64_t ReadFully(duckdb::FileHandle &handle, void *buf, duckdb::idx_t nr_bytes) {
+	duckdb::idx_t total = 0;
+	while (total < nr_bytes) {
+		int64_t n = handle.Read(static_cast<char *>(buf) + total, nr_bytes - total);
+		if (n <= 0) {
+			break;
+		}
+		total += (duckdb::idx_t)n;
+	}
+	return (int64_t)total;
+}
