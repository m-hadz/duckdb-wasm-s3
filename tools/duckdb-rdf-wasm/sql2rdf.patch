+R2RMLMapping MappingParser::parseMultipleFromStrings(const std::vector<Source> &sources, bool ignoreNonFatalErrors,
+                                                     bool forceYarrrml) {
+	TripleCollector collector;
+
+	for (const Source &source : sources) {
+		collector.beginSource(source.path);
+
+		if (forceYarrrml || yarrrml::YARRRMLParser::hasYarrrmlExtension(source.path)) {
+			yarrrml::YARRRMLParser().collectString(source.content, source.baseUri, collector);
+		} else if (hasTtlExtension(source.path)) {
+			R2RMLParser().collectString(source.content, source.baseUri, collector);
+		} else {
+			throw std::runtime_error("No parser available for file: " + source.path +
+			                         " (expected .ttl for R2RML or .yml/.yaml/.yarrrml for YARRRML)");
+		}
+	}
+
+	return R2RMLParser().parseCollected(collector, ignoreNonFatalErrors);
+}
+
 } // namespace r2rml
